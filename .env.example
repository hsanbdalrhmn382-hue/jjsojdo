# GEMINI_API_KEY: Optional AI Studio runtime variable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Automatically injected by AI Studio.
APP_URL="MY_APP_URL"

# Supabase Public Connection Settings (Required for TOP CODES)
# Set these in your .env file or AI Studio Secrets panel.
# NEVER put SUPABASE_SERVICE_ROLE_KEY in frontend code.
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
